# Response headers for Cloudflare Pages and Netlify (both read this file).
# The content security policy itself is a <meta> tag added at build time (see vite.config.ts),
# so it also applies on hosts that ignore this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Built files have a hash in their name, so they never change and can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always check for a new version of the app.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
